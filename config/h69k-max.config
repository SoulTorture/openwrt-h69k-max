# =============================================================================
# HINLINK H69K-MAX (RK3568) - OpenWrt / Lean(LEDE) build seed config
# 设备: H69K-MAX  SoC: RK3568  RAM: 4GB  eMMC: 32GB
# 网口: 1x1GbE(RTL8211F, gmac1) + 2x2.5GbE(RTL8125B, PCIe)
# WiFi: MT7916 (mini-PCIe)   5G: Quectel RM520N-GL   USB2.0 x1   HDMI2.0 x1
#
# 目标源: coolsnowwolf/lede (master)  —— 只有该源码树内置 hinlink_opc-h69k
# 用法: 由 .github/workflows/build-h69k-max.yml 自动:
#       cp 到 openwrt/.config -> make defconfig -> make -j$(nproc)
#
# 注意: 本文件不需要写全所有选项, make defconfig 会自动补全。
#       所有包名均已逐一核实 (见 README 与工作流内的符号校验步骤)。
# =============================================================================

#
# Target system / 目标平台
#
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_opc-h69k=y
CONFIG_TARGET_BOARD="rockchip"
CONFIG_TARGET_SUBTARGET="armv8"
CONFIG_TARGET_PROFILE="DEVICE_hinlink_opc-h69k"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_generic"

#
# Image / 镜像设置
# 32GB eMMC -> rootfs 分区默认 4020MB (与上游 H69K 配置一致, 可调)
#
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_EXT4_RESERVED_PCT=0
CONFIG_TARGET_EXT4_BLOCKSIZE_4K=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=4020

#
# 国内编译建议打开镜像加速 (若 GitHub 拉取慢可取消注释)
#
# CONFIG_LOCALMIRROR=y

#
# -----------------------------------------------------------------------------
# 无线: MT7916 (H69K-MAX 的 mini-PCIe 网卡)
#   MT7916 = mt7915e 驱动 + mt76-connac + mt7916 固件
#   板级 hinlink_common 已默认带 kmod-mt7921e + wpad-openssl,
#   H69K 板级追加了 kmod-mt7916-firmware; 此处再显式声明 mt7915e 与 mt76 栈。
# -----------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7916-firmware=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt76-connac=y

#
# -----------------------------------------------------------------------------
# 5G 模块: Quectel RM520N-GL
#   -> 相关选项全部放在 config/5g-rm520n.config, 由工作流自动追加。
#      该文件编入 USB 全模式链路 (QMI/MBIM/NCM/RNDIS); PCIe/MHI 链路因
#      LEDE 自带 Quectel 驱动与内核 6.18 不兼容 (实测编译失败) 已移除。
# -----------------------------------------------------------------------------

#
# -----------------------------------------------------------------------------
# 风扇 / 温控 (H69K 设备树: pwm-fan, 40°C 起转, 4 档 cooling-levels)
# kmod-hwmon-pwmfan 为板级默认, 此处显式声明以防默认值变动
# -----------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y
CONFIG_PACKAGE_kmod-thermal=y

#
# -----------------------------------------------------------------------------
# 有线网卡 / SATA (板级 hinlink_common 默认已含, 显式声明以防上游默认变更)
# -----------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-r8125-rss=y
CONFIG_PACKAGE_kmod-ata-ahci-dwc=y
CONFIG_PACKAGE_kmod-drm-rockchip=y

#
# -----------------------------------------------------------------------------
# 基础工具 (eMMC/分区/文件系统操作, 便于刷机后自行扩容与排错)
# -----------------------------------------------------------------------------
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_ethtool=y

#
# -----------------------------------------------------------------------------
# LuCI 中文界面 (luci-base 选项; zh-cn 翻译内置于各 luci-app 的 po/zh_Hans)
# -----------------------------------------------------------------------------
CONFIG_LUCI_LANG_zh_Hans=y
