# =============================================================================
# Quectel RM520N-GL 5G 模块支持  —— 附加配置
#
# 由 .github/workflows/build-h69k-max.yml 追加到 h69k-max.config 之后。
# 所有包名均已逐一核对 (coolsnowwolf/lede master + coolsnowwolf/packages +
# coolsnowwolf/luci@openwrt-25.12 实际存在的 Package/KernelPackage 定义)。
#
# 为什么只编 USB 链路:
#   H69K 的设备树里没有任何 5G/Modem 节点 (已核对 dts/dtsi)。按厂商硬件文档
#   与拆机资料, M.2 5G 座引出的是 USB 通道 (整机 USB2.0 接口即 5G 模块),
#   RM520N-GL 的 USB 模式 (QMI/MBIM/NCM/RNDIS) 已覆盖全部工作模式。
#
#   曾经尝试同时编入 PCIe/MHI 链路 (LEDE 自带的 Quectel 外置驱动
#   KernelPackage/pcie_mhi), 实测与内核 6.18 头文件不兼容、编译失败;
#   且主线 MHI kmod 并不存在于 LEDE。故移除, 避免拖垮整包编译。
# =============================================================================

#
# --- USB 链路 (串口 AT/DIAG + 各种网卡模式) ---
#
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

#
# --- 拨号协议与工具 (LEDE core 已核实存在) ---
#
CONFIG_PACKAGE_wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_luci-proto-ncm=y

#
# --- 模块状态 / 锁频 / 短信 (包名已核实: luci@openwrt-25.12 + packages) ---
#
CONFIG_PACKAGE_luci-app-modemband=y
CONFIG_PACKAGE_modemband=y
CONFIG_PACKAGE_luci-app-3ginfo-lite=y
CONFIG_PACKAGE_sms-tool=y
CONFIG_PACKAGE_luci-app-sms-tool-js=y
CONFIG_PACKAGE_picocom=y
