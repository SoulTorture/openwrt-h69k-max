# 行尾策略: 脚本/config 在 Linux runner 上必须 LF
* text=auto

*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.config text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.mk     text eol=lf
*.dts    text eol=lf
*.dtsi   text eol=lf

*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

*.png    binary
*.jpg    binary
*.img    binary
*.gz     binary
*.xz     binary
*.zip    binary
*.bin    binary
